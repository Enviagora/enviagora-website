<style>
  .custom-video-wrapper {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .video-container {
    position: relative;
    width: 100%;
    max-width: 720px;
    border-radius: 12px;
    overflow: hidden;
    background-color: #000;
  }

  video {
    width: 100%;
    height: auto;
    display: block;
    transition: filter 0.2s ease;
  }

video.blurred {
  filter: brightness(1.1) blur(3px);
}

  .overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: none;
    justify-content: center;
    align-items: center;
    pointer-events: none;
  }

  .overlay.visible {
    display: flex;
    pointer-events: all;
  }

  .overlay-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(6px);
    z-index: 1;
  }

  .overlay-button {
    position: relative;
    z-index: 2;
    background-color: #C4FF57;
    border: 2px solid white;
    border-radius: 16px;
    padding: 20px 16px;
    width: 60%;
    opacity: 0.85;
    text-align: center;
    color: #033212;
    font-family: 'Degular', sans-serif;
    font-weight: 700;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.3);
  }

  .overlay-title {
    font-size: 18px;
    margin-bottom: 12px;
    font-weight: 700;
    letter-spacing: -0.2px;
  }

  .overlay-subtitle {
    font-size: 16px;
    margin-top: 12px;
    font-weight: 700;
    letter-spacing: -0.2px;
  }

  .overlay .icon {
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 0 auto;
    margin-top: 8px;
  }

  .overlay .icon svg {
    width: 80px;
    height: 80px;
    stroke: #033212;
  }

  @media (max-width: 480px) {
    .overlay-title,
    .overlay-subtitle {
      font-size: 16px;
    }

    .overlay .icon svg {
      width: 72px;
      height: 72px;
    }

    .overlay-button {
      padding: 18px 14px;
    }
  }
</style>

<script>
  const video = document.getElementById("customVideo");
  const overlay = document.getElementById("videoOverlay");
  const icon = document.getElementById("overlayIcon");
  const title = document.getElementById("overlayTitle");
  const subtitle = document.getElementById("overlaySubtitle");

  const icons = {
    play: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" stroke="#033212" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
             <polygon points="5 3 19 12 5 21 5 3"></polygon>
           </svg>`,
    mute: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" stroke="#033212" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
             <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
             <line x1="23" y1="9" x2="17" y2="15"></line>
             <line x1="17" y1="9" x2="23" y2="15"></line>
           </svg>`
  };

  function applyBlur(shouldBlur) {
    if (shouldBlur) {
      video.classList.add("blurred");
    } else {
      video.classList.remove("blurred");
    }
  }

  overlay.addEventListener("click", () => {
    video.muted = false;
    video.play();
    overlay.classList.remove("visible");
    applyBlur(false);
  });

  video.addEventListener("click", () => {
    if (!video.paused) {
      video.pause();
      title.innerText = "Vídeo pausado";
      subtitle.innerText = "Clique para voltar a assistir";
      icon.innerHTML = icons.play;
      overlay.classList.add("visible");
      applyBlur(true);
    }
  });

  video.addEventListener("ended", () => {
    title.innerText = "Vídeo pausado";
    subtitle.innerText = "Clique para voltar a assistir";
    icon.innerHTML = icons.play;
    overlay.classList.add("visible");
    applyBlur(true);
  });

  document.addEventListener("DOMContentLoaded", () => {
    icon.innerHTML = icons.mute;
    applyBlur(true);
  });
</script>
