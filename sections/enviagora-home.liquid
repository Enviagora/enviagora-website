{%- comment -%}
  Home Enviagora — app React gerado por `npm run build:theme`
  (assets/enviagora-home.js + .css). O HTML já vem pré-renderizado do snippet
  enviagora-home-ssr (gerado no build) e o React hidrata em cima dele.
  Os settings abaixo chegam ao app via #enviagora-config; o resto do conteúdo
  vive em src/content/content.ts.
{%- endcomment -%}
{{ 'enviagora-home.css' | asset_url | stylesheet_tag }}
<link rel="modulepreload" href="{{ 'enviagora-home.js' | asset_url }}">

<script type="application/json" id="enviagora-config">
  {
    "hubspot": {
      "portalId": {{ section.settings.hubspot_portal_id | json }},
      "formId": {{ section.settings.hubspot_form_id | json }},
      "region": {{ section.settings.hubspot_region | json }},
      "meetingsUrl": {{ section.settings.meetings_url | json }}
    },
    "whatsapp": {
      "number": {{ section.settings.whatsapp_number | json }},
      "message": {{ section.settings.whatsapp_message | json }}
    }
  }
</script>

{%- comment -%} Sem espaços entre a div e o snippet: o conteúdo precisa bater com o React. {%- endcomment -%}
<div id="enviagora-home">{%- render 'enviagora-home-ssr' -%}</div>

<noscript>
  {%- comment -%} Sem JS, as animações de entrada não rodam — mostra tudo. {%- endcomment -%}
  <style>
    #enviagora-home [style*="opacity:0"] { opacity: 1 !important; transform: none !important; }
  </style>
</noscript>

<script type="module" src="{{ 'enviagora-home.js' | asset_url }}"></script>

{% schema %}
{
  "name": "Home Enviagora",
  "tag": "section",
  "class": "enviagora-home-section",
  "limit": 1,
  "enabled_on": {
    "templates": ["index"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Formulário de contato (HubSpot)"
    },
    {
      "type": "paragraph",
      "content": "Os leads vão para o formulário do HubSpot abaixo. Só altere se o formulário mudar no HubSpot."
    },
    {
      "type": "text",
      "id": "hubspot_portal_id",
      "label": "Portal ID",
      "default": "44097462"
    },
    {
      "type": "text",
      "id": "hubspot_form_id",
      "label": "Form ID",
      "default": "909bd17e-13cd-40b2-b996-96f5817b8587"
    },
    {
      "type": "select",
      "id": "hubspot_region",
      "label": "Região",
      "options": [
        { "value": "na1", "label": "na1 (América do Norte)" },
        { "value": "eu1", "label": "eu1 (Europa)" }
      ],
      "default": "na1"
    },
    {
      "type": "url",
      "id": "meetings_url",
      "label": "Link de agendamento (HubSpot Meetings)",
      "info": "Opcional. Ex.: https://meetings.hubspot.com/seu-usuario. Se preenchido, a agenda aparece logo após o envio do formulário."
    },
    {
      "type": "header",
      "content": "WhatsApp comercial"
    },
    {
      "type": "text",
      "id": "whatsapp_number",
      "label": "Número (com DDI e DDD, só dígitos)",
      "info": "Ex.: 5535936180694. Deixe vazio para esconder todos os botões de WhatsApp.",
      "default": "5535936180694"
    },
    {
      "type": "textarea",
      "id": "whatsapp_message",
      "label": "Mensagem inicial",
      "default": "Olá! Quero falar com um especialista da Enviagora sobre a minha operação."
    }
  ],
  "presets": [
    {
      "name": "Home Enviagora"
    }
  ]
}
{% endschema %}
