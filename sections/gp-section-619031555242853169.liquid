            d="M380.9 97.1C339-2.9 248.4-27.3 167.2 8.1 86 43.6 32.1 120.1 32 207.6c0 40.1 10.6 79.4 30.6 114L2.5 470.3a12.5 12.5 0 0 0 17.2 17.2l148.7-60.1a228 228 0 0 0 99.5 24c87.7 0 164.2-53.9 199.7-135.1 35.4-81.2 11-171.8-57.7-219.2zM248.1 396c-30.2 0-59.6-8.1-85.3-23.4l-6.1-3.6-88.2 35.6 33.6-90.3-5.3-8.5a174 174 0 0 1-26.2-91.7C70 137.4 114.6 77 179.2 48.6c64.6-28.4 139.4-7.6 179.6 49.7 40.2 57.2 34.3 134.5-14.1 185.2-27.2 28.2-64 43.5-102.6 43.5zM293.3 297.3c-5-2.5-29.6-14.6-34.2-16.3-4.6-1.7-8-2.5-11.4 2.5-3.3 5-13.1 16.3-16.1 19.7-2.9 3.3-5.8 3.8-10.8 1.3-5-2.5-21.1-7.8-40.2-24.9-14.9-13.3-25-29.7-27.9-34.7-2.9-5-0.3-7.7 2.2-10.2 2.3-2.3 5-5.8 7.5-8.7 2.5-2.9 3.3-5 5-8.3 1.7-3.3 0.8-6.3-0.4-8.8-1.2-2.5-11.4-27.4-15.6-37.5-4.1-9.9-8.3-8.6-11.4-8.8-2.9-0.2-6.3-0.2-9.6-0.2s-8.8 1.2-13.3 6.3c-4.6 5-17.5 17.1-17.5 41.6 0 24.5 17.9 48.1 20.4 51.5 2.5 3.3 35.2 53.6 85.3 75.1 11.9 5.1 21.1 8.1 28.3 10.3 11.9 3.8 22.8 3.3 31.4 2 9.6-1.4 29.6-12.1 33.8-23.7 4.2-11.6 4.2-21.6 2.9-23.6-1.2-2.1-4.6-3.3-9.6-5.8z" />
