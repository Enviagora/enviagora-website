    <head>
  <!-- HEAD -->
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600&display=swap" rel="stylesheet">

  <style>
    .form-whats-container {
      font-family: 'Sora', sans-serif;
      padding: 24px;
      max-width: 600px;
      margin: auto;
    }

    button.form-whats-button {
      background: #006FCD !important;
      height: 50px !important;
      color: white !important;
    }

    form#formulario {
      letter-spacing: -0.3px !important;
    }

    .form-whats-form {
      display: flex;
      flex-direction: column;
      gap: 24px;
    }

    input#nome,
    input#quantidade,
    input#marca,
    input#whatsapp {
      height: 38px !important;
    }

    .form-whats-label {
      font-weight: 600;
      margin-bottom: 6px;
      color: #000;
      font-size: 16px;
      display: block;
    }

    .form-whats-input {
      width: 100%;
      padding: 18px 20px;
      font-size: 16px;
      border-radius: 10px;
      background-color: #f7f7f7;
      font-family: 'Sora', sans-serif;
      border: 1px solid #ccc;
      box-sizing: border-box;
    }

    .form-whats-input:focus {
      outline: 2px solid #c9c9c9;
    }

    .form-whats-button {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      padding: 18px;
      font-size: 16px;
      background-color: #007AFF;
      color: white;
      border: none;
      border-radius: 999px;
      cursor: pointer;
      font-weight: 600;
      font-family: 'Sora', sans-serif;
      text-align: center;
      width: 100%;
      transition: background-color 0.2s ease;
      text-decoration: none;
    }

    .form-whats-button:hover {
      background-color: #0066d1;
    }

    .form-whats-button svg {
      width: 20px;
      height: 20px;
      fill: white;
      flex-shrink: 0;
    }

    .form-whats-text {
      display: inline;
    }

    .form-whats-text .underline {
      text-decoration: underline;
    }
  </style>
</head>

<body>
  <!-- FORMULÁRIO -->
  <div class="form-whats-container">
    <form id="formulario" class="form-whats-form">
      <div>
        <label for="nome" class="form-whats-label">Seu nome*</label>
        <input type="text" id="nome" name="nome" class="form-whats-input" required>
      </div>

      <div>
        <label for="marca" class="form-whats-label">Marca*</label>
        <input type="text" id="marca" name="marca" class="form-whats-input" required>
      </div>

      <div>
        <label for="quantidade" class="form-whats-label">Quantidade de envios no mês*</label>
        <input type="number" id="quantidade" name="quantidade" class="form-whats-input" required>
      </div>

      <!-- NOVO CAMPO WHATSAPP -->
      <div>
        <label for="whatsapp" class="form-whats-label">WhatsApp*</label>
        <input type="text" id="whatsapp" name="whatsapp" class="form-whats-input" required
               placeholder="(11) 91234-5678" maxlength="15">
      </div>

      <button type="submit" class="form-whats-button">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512">
