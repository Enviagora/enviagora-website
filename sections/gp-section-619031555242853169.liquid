        <span class="form-whats-text">
          Chamar no WhatsApp
        </span>
      </button>
    </form>
  </div>

  <!-- JS -->
  <script>
    /** Aplicar máscara ao campo WhatsApp */
    function aplicarMascaraWhatsApp(input) {
      input.addEventListener('input', () => {
        let valor = input.value.replace(/\D/g, ''); // Remove tudo que não é número

        if (valor.length > 11) valor = valor.slice(0, 11); // Máximo 11 dígitos

        if (valor.length > 6) {
          input.value = `(${valor.slice(0, 2)}) ${valor.slice(2, 7)}-${valor.slice(7)}`;
        } else if (valor.length > 2) {
          input.value = `(${valor.slice(0, 2)}) ${valor.slice(2)}`;
        } else if (valor.length > 0) {
          input.value = `(${valor}`;
        } else {
          input.value = '';
        }
      });
    }

    document.addEventListener('DOMContentLoaded', () => {
      const inputWhats = document.getElementById('whatsapp');
      aplicarMascaraWhatsApp(inputWhats);

      /** SUBMISSÃO DO FORMULÁRIO */
      document.getElementById('formulario').addEventListener('submit', async function (e) {
        e.preventDefault();

        const nome = document.getElementById('nome').value.trim();
        const marca = document.getElementById('marca').value.trim();
        const quantidade = document.getElementById('quantidade').value.trim();
        const whatsapp = document.getElementById('whatsapp').value.trim();

        if (!nome || !marca || !quantidade || !whatsapp) {
          alert("Por favor, preencha todos os campos obrigatórios.");
          return;
        }

