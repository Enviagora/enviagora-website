<div class="env-form">

  <div class="env-field">
    <label>Nome <span class="env-req">*</span></label>
    <input type="text" id="env-nome" placeholder="">
    <div class="env-error" id="env-err-nome">Preencha esse campo obrigatório.</div>
  </div>

