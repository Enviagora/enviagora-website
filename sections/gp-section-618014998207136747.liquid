      <select id="env-pais" onchange="envAtualizarPais()"></select>
      <input type="tel" id="env-ddd" placeholder="DDD" maxlength="3">
      <input type="tel" class="env-phone-input" id="env-whatsapp" placeholder="Número">
    </div>
    <div class="env-error" id="env-err-whatsapp">Preencha esse campo obrigatório.</div>
  </div>

  <div class="env-field">
    <label>Nome da empresa <span class="env-req">*</span></label>
    <input type="text" id="env-empresa" placeholder="">
    <div class="env-error" id="env-err-empresa">Preencha esse campo obrigatório.</div>
  </div>

  <div class="env-field">
    <label>Seu site</label>
    <input type="text" id="env-site" placeholder="">
  </div>

  <div class="env-field">
    <label>Quantidade de envios por mês <span class="env-req">*</span></label>
    <input type="number" id="env-envios" placeholder="">
    <div class="env-error" id="env-err-envios">Preencha esse campo obrigatório.</div>
  </div>

  <div class="env-field">
    <label>Como você conheceu a Enviagora? <span class="env-req">*</span></label>
    <div class="env-conheceu-list">
      <label class="env-conheceu-item"><input type="radio" name="env-conheceu" value="Indicação"><span>Indicação</span></label>
      <label class="env-conheceu-item"><input type="radio" name="env-conheceu" value="Instagram"><span>Instagram</span></label>
      <label class="env-conheceu-item"><input type="radio" name="env-conheceu" value="Pesquisa"><span>Pesquisa</span></label>
      <label class="env-conheceu-item"><input type="radio" name="env-conheceu" value="Vi alguém postando"><span>Vi alguém postando</span></label>
      <label class="env-conheceu-item"><input type="radio" name="env-conheceu" value="Conheço marcas que operam aí"><span>Conheço marcas que operam aí</span></label>
      <label class="env-conheceu-item"><input type="radio" name="env-conheceu" value="Conheço o Rafael"><span>Conheço o Rafael</span></label>
      <label class="env-conheceu-item"><input type="radio" name="env-conheceu" value="Outro" onclick="document.getElementById('env-conheceu-outro').classList.add('env-show')"><span>Outro</span></label>
    </div>
    <div class="env-conheceu-outro" id="env-conheceu-outro">
      <input type="text" id="env-conheceu-outro-txt" placeholder="Conte como nos encontrou...">
    </div>
    <div class="env-error" id="env-err-conheceu">Selecione uma opção.</div>
  </div>

