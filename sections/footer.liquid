  function envAtualizarPaisEl(sel) {
    if (!sel) return;
    var row = sel.closest('.env-phone-row');
    if (!row) return;
    var dddInput = row.querySelector('input[maxlength="3"]');
    if (!dddInput) return;
    var nome = sel.options[sel.selectedIndex] ? sel.options[sel.selectedIndex].textContent : '';
    var isBrasil = nome.indexOf('Brazil') !== -1;
    dddInput.style.display = isBrasil ? '' : 'none';
    dddInput.value = '';
  }

  window.envAtualizarPais = function(el) { envAtualizarPaisEl(el || document.getElementById('env-pais')); };
  window.env2AtualizarPais = function(el) { envAtualizarPaisEl(el || document.getElementById('env2-pais')); };

  function envPopularTodosPaises() {
    document.querySelectorAll('#env-pais, #env2-pais').forEach(function(sel) {
      if (sel.dataset.envPopulated) return;
      sel.dataset.envPopulated = '1';
      sel.innerHTML = '';
      ENV_PAISES.forEach(function(p) {
        var opt = document.createElement('option');
        opt.value = p.codigo;
        opt.textContent = p.nome + ' (' + p.codigo + ')';
        sel.appendChild(opt);
      });
      envAtualizarPaisEl(sel);
      sel.addEventListener('change', function() { envAtualizarPaisEl(sel); });
    });
  }

  window.envAbrirModal = function() {
    var overlay = document.getElementById('env-modal-overlay');
    overlay.classList.add('env-show');
    overlay.scrollTop = 0;
    envPopularTodosPaises();
  };

  window.envFecharModal = function() {
    document.getElementById('env-modal-overlay').classList.remove('env-show');
  };

  window.envToggleCanal = function(checkbox) {
    var row = checkbox.closest('.env-canal-row');
    if (checkbox.checked) {
      row.classList.add('env-ativo');
    } else {
      row.classList.remove('env-ativo');
      row.querySelector('.env-canal-pct').value = '';
    }
  };

  function gerarEmailTemplate1(nome, empresa, whatsapp, site, envios, conheceu) {
    return '<!DOCTYPE html><html><head><meta charset="UTF-8"><style>body{font-family:\'Segoe UI\',Tahoma,Geneva,Verdana,sans-serif;background:#f5f5f5;margin:0;padding:0}.container{max-width:600px;margin:0 auto;background:#fff;border-radius:8px;overflow:hidden;box-shadow:0 2px 8px rgba(0,0,0,0.1)}.header{background:linear-gradient(135deg,#1b1b1b 0%,#2d2d2d 100%);padding:40px 20px;text-align:center}.header h1{color:#b5ff47;font-size:28px;margin:0;font-weight:700}.header p{color:#ccc;font-size:14px;margin:8px 0 0 0}.content{padding:40px}.section{margin-bottom:32px}.section h2{color:#1b1b1b;font-size:16px;font-weight:700;margin:0 0 16px 0;border-bottom:2px solid #b5ff47;padding-bottom:8px}.field{margin-bottom:12px;display:flex;align-items:flex-start}.label{font-weight:700;color:#555;width:140px;flex-shrink:0}.value{color:#333;flex:1}.highlight{background:#f0f0f0;padding:16px;border-radius:6px;border-left:4px solid #b5ff47;margin:16px 0}.footer{background:#f9f9f9;padding:24px 40px;border-top:1px solid #eee;text-align:center;font-size:12px;color:#999}.footer p{margin:0;line-height:1.6}</style></head><body><div class="container"><div class="header"><h1>📬 Novo Lead Qualificado</h1><p>Alguém interessado em seus serviços</p></div><div class="content"><div class="highlight"><strong style="font-size:18px;color:#b5ff47">✅ Qualificado: ' + envios + '+ envios/mês</strong></div><div class="section"><h2>Informações de Contato</h2><div class="field"><span class="label">Nome:</span><span class="value"><strong>' + nome + '</strong></span></div><div class="field"><span class="label">Empresa:</span><span class="value"><strong>' + empresa + '</strong></span></div><div class="field"><span class="label">WhatsApp:</span><span class="value"><strong>' + whatsapp + '</strong></span></div>' + (site ? '<div class="field"><span class="label">Site:</span><span class="value"><a href="' + site + '" style="color:#0066cc;text-decoration:none">' + site + '</a></span></div>' : '') + '</div><div class="section"><h2>Informações de Negócio</h2><div class="field"><span class="label">Envios/mês:</span><span class="value"><strong>' + envios + '</strong></span></div><div class="field"><span class="label">Como conheceu:</span><span class="value">' + conheceu + '</span></div></div><div class="highlight" style="background:#e8f5e9;border-left-color:#4caf50"><strong style="color:#2e7d32">🎯 Próximo passo:</strong> Entrar em contato via WhatsApp: ' + whatsapp + '</div></div><div class="footer"><p><strong>Enviagora</strong> | Fulfillment &amp; Logistics</p><p>Recebido em: ' + new Date().toLocaleDateString('pt-BR',{weekday:'long',year:'numeric',month:'long',day:'numeric',hour:'2-digit',minute:'2-digit'}) + '</p></div></div></body></html>';
