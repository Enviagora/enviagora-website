<script>
window.addEventListener('load', function () {

  const contadores = document.querySelectorAll('.contador-numero');

  const observer = new IntersectionObserver((entries, obs) => {
    entries.forEach(entry => {
      if (!entry.isIntersecting) return;

      const contador = entry.target;

      // evita rodar mais de uma vez
      if (contador.classList.contains('animado')) return;
      contador.classList.add('animado');

      const numeroInicial = parseFloat(contador.dataset.inicial);
      const numeroFinal   = parseFloat(contador.dataset.final);
      const sufixo        = contador.dataset.sufixo || '';
      const casasDecimais = parseInt(contador.dataset.decimais);
      const duracao       = parseInt(contador.dataset.duracao);

      const inicio = performance.now();

      function animar(tempoAtual){
        const progresso = Math.min((tempoAtual - inicio) / duracao, 1);
        const valorAtual = numeroInicial + (numeroFinal - numeroInicial) * progresso;

        const valorFormatado = valorAtual.toLocaleString('pt-BR', {
          minimumFractionDigits: casasDecimais,
          maximumFractionDigits: casasDecimais
        });

        contador.textContent = `${valorFormatado}${sufixo}`;

        if (progresso < 1) {
          requestAnimationFrame(animar);
        }
      }

      requestAnimationFrame(animar);

      // para de observar após animar
      obs.unobserve(contador);
    });
  }, {
    threshold: 0.4
  });

  contadores.forEach(contador => observer.observe(contador));

});
</script>
