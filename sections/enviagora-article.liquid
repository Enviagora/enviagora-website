{%- comment -%}
  Artigo do blog com a identidade Enviagora: cabeçalho legível, imagem,
  conteúdo com tipografia de leitura, compartilhar, CTA para o especialista e
  "Continue lendo".
{%- endcomment -%}
{%- liquid
  assign ea_words = article.content | strip_html | split: ' ' | size
  assign ea_min = ea_words | divided_by: 200 | at_least: 1
  assign ea_url = shop.url | append: article.url
  assign ea_alt = article.image.alt | default: article.title | escape
  assign ea_home = routes.root_url
  if ea_home == '/'
    assign ea_home = ''
  endif
-%}
{%- render 'enviagora-blog-styles' -%}
<style>
  .ea-art { padding: clamp(28px, 5vw, 64px) 0 0; }
  .ea-art__narrow { max-width: 760px; margin: 0 auto; padding: 0 clamp(20px, 5vw, 48px); }
  .ea-art__back { display: inline-flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 700; color: #123336; text-decoration: none; }
  .ea-art__back:hover { text-decoration: underline; text-decoration-color: #c4ff57; text-decoration-thickness: 2px; text-underline-offset: 4px; }
  .ea-art__meta { display: block; margin-top: 22px; font-size: 13px; color: #2a5b5f; }
  .ea-art__title { margin: 10px 0 0; font-family: var(--font-heading-family); font-weight: 500; text-transform: uppercase; letter-spacing: .02em; line-height: 1.12; font-size: clamp(26px, 4.2vw, 46px); color: #123336; overflow-wrap: break-word; hyphens: auto; }
  .ea-art__hero { max-width: 1100px; margin: clamp(24px, 4vw, 44px) auto 0; padding: 0 clamp(0px, 3vw, 48px); }
  .ea-art__hero img { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; border-radius: 0; }
  @media (min-width: 750px) { .ea-art__hero img { border-radius: 16px; } }

  /* Conteúdo (rich text do Shopify) */
  .ea-rte { margin-top: clamp(28px, 4vw, 48px); font-size: 18px; line-height: 1.72; color: #1b3f42; }
  .ea-rte > * + * { margin-top: 1em; }
  .ea-rte p { margin: 0; font-size: 18px; letter-spacing: 0; }
  .ea-rte p + p { margin-top: 1em; }
  .ea-rte h2, .ea-rte h3, .ea-rte h4 { font-family: var(--font-heading-family); color: #123336; letter-spacing: 0; text-transform: none; line-height: 1.25; font-weight: 700; margin: 1.8em 0 .5em; }
  .ea-rte h2 { font-size: clamp(22px, 2.6vw, 27px); }
  .ea-rte h3 { font-size: clamp(19px, 2.2vw, 22px); }
  .ea-rte h4 { font-size: 18px; }
  .ea-rte ul, .ea-rte ol { padding-left: 1.3em; margin: 1em 0; }
  .ea-rte li + li { margin-top: .4em; }
  .ea-rte li::marker { color: #3e7478; }
  .ea-rte a { color: #123336; font-weight: 600; text-decoration: underline; text-decoration-color: #c4ff57; text-decoration-thickness: 2px; text-underline-offset: 3px; }
  .ea-rte strong { color: #123336; }
  .ea-rte img { max-width: 100%; height: auto; border-radius: 12px; border: 0 !important; }
  .ea-rte blockquote { margin: 1.6em 0; padding: 4px 0 4px 20px; border-left: 3px solid #c4ff57; font-size: 20px; color: #123336; }
  .ea-rte table { width: 100%; border-collapse: collapse; font-size: 15px; display: block; overflow-x: auto; }
  .ea-rte th, .ea-rte td { border: 1px solid rgba(18,51,54,.15); padding: 8px 12px; text-align: left; }

  .ea-art__share { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin-top: 40px; padding-top: 24px; border-top: 1px solid rgba(18,51,54,.12); }
  .ea-art__share > span { font-size: 12px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: #2a5b5f; margin-right: 4px; }
  .ea-art__share a, .ea-art__share button { display: inline-flex; align-items: center; gap: 8px; height: 40px; padding: 0 14px; border-radius: 8px; border: 1px solid rgba(18,51,54,.2); background: #fff; color: #123336; font: 600 13px/1 var(--font-body-family); letter-spacing: 0; cursor: pointer; text-decoration: none; }
  .ea-art__share a:hover, .ea-art__share button:hover { border-color: #123336; }
  .ea-art__share svg { width: 16px; height: 16px; }

  .ea-cta { margin: clamp(40px, 6vw, 64px) auto 0; max-width: 1100px; padding: 0 clamp(20px, 5vw, 48px); }
  .ea-cta__box { position: relative; overflow: hidden; border-radius: 24px; background: #123336; color: #fafaf5; padding: clamp(28px, 5vw, 56px); display: grid; gap: 20px; }
  .ea-cta__box > svg { position: absolute; right: -40px; top: -40px; width: 260px; height: 260px; color: rgba(196,255,87,.07); }
  .ea-cta__kicker { position: relative; font-size: 12px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: #c4ff57; }
  .ea-cta__title { position: relative; margin: 0; font-family: var(--font-heading-family); font-weight: 500; text-transform: uppercase; letter-spacing: .02em; line-height: 1.12; font-size: clamp(24px, 3.4vw, 38px); color: #fafaf5; max-width: 22ch; }
  .ea-cta__text { position: relative; margin: 0; font-size: 16px; line-height: 1.6; color: #9bbbbc; max-width: 560px; }
  .ea-cta__btn { position: relative; justify-self: start; display: inline-flex; align-items: center; gap: 10px; background: #c4ff57; color: #123336; border-radius: 8px; padding: 15px 20px; font-size: 13px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; text-decoration: none; transition: background .2s; }
  .ea-cta__btn:hover { background: #d5ff8b; }
  .ea-cta__btn svg { width: 12px; height: 12px; }

  .ea-related { padding: clamp(48px, 7vw, 88px) 0 clamp(56px, 8vw, 104px); }
  .ea-related__title { margin: 0 0 24px; font-family: var(--font-heading-family); font-weight: 500; text-transform: uppercase; letter-spacing: .02em; font-size: clamp(22px, 2.8vw, 30px); color: #123336; }
</style>

<div class="ea-blog-page">
  <article class="ea-art">
    <header class="ea-art__narrow">
      <a class="ea-art__back" href="{{ blog.url }}">← Todos os artigos</a>
      <span class="ea-art__meta">
        {{- article.published_at | date: '%d/%m/%Y' }} · {{ ea_min }} min de leitura
      </span>
      <h1 class="ea-art__title">{{ article.title | escape }}</h1>
    </header>

    {%- if article.image -%}
      <figure class="ea-art__hero">
        {{
          article.image
          | image_url: width: 2000
          | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            widths: '600, 900, 1200, 1600, 2000',
            sizes: '(min-width: 1100px) 1100px, 100vw',
            alt: ea_alt
        }}
      </figure>
    {%- endif -%}

    <div class="ea-art__narrow">
      <div class="ea-rte">{{ article.content }}</div>

      <div class="ea-art__share">
        <span>Compartilhar</span>
        <a href="https://www.linkedin.com/sharing/share-offsite/?url={{ ea_url | url_encode }}" target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg>
          LinkedIn
        </a>
        <button type="button" data-ea-copy="{{ ea_url }}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
          <span data-ea-copy-label>Copiar link</span>
        </button>
      </div>
    </div>
  </article>

  <aside class="ea-cta">
    <div class="ea-cta__box">
      {%- render 'enviagora-arrow' -%}
      <span class="ea-cta__kicker">Fulfillment Enviagora</span>
      <p class="ea-cta__title">Leve sua operação para o próximo nível</p>
      <p class="ea-cta__text">
        Estamos selecionando marcas com +5.000 envios/mês que buscam uma logística 5 estrelas. Fale com um
        especialista e entenda quanto sua operação pode economizar.
      </p>
      <a class="ea-cta__btn" href="{{ ea_home }}/#contato">
        Falar com um especialista
        {%- render 'enviagora-arrow' -%}
      </a>
    </div>
  </aside>

  {%- liquid
    assign ea_related = 0
    for a in blog.articles limit: 4
      if a.id != article.id
        assign ea_related = ea_related | plus: 1
      endif
    endfor
  -%}
  {%- if ea_related > 0 -%}
    <section class="ea-related">
      <div class="ea-wrap">
        <h2 class="ea-related__title">Continue lendo</h2>
        <div class="ea-grid">
          {%- assign ea_shown = 0 -%}
          {%- for a in blog.articles limit: 4 -%}
            {%- if a.id != article.id and ea_shown < 3 -%}
              {%- render 'enviagora-article-card', article: a, heading_tag: 'h3' -%}
              {%- assign ea_shown = ea_shown | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}
</div>

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": {{ article.title | json }},
    "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
    "dateModified": {{ article.updated_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
    "mainEntityOfPage": {{ ea_url | json }},
    {%- if article.image %}
    "image": {{ article.image | image_url: width: 1600 | prepend: 'https:' | json }},
    {%- endif %}
    "author": { "@type": "Organization", "name": "Enviagora" },
    "publisher": { "@type": "Organization", "name": "Enviagora" }
  }
</script>

<script>
  document.querySelectorAll('[data-ea-copy]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var label = btn.querySelector('[data-ea-copy-label]');
      var done = function () {
        if (!label) return;
        label.textContent = 'Link copiado';
        setTimeout(function () { label.textContent = 'Copiar link'; }, 2000);
      };
      if (navigator.clipboard) navigator.clipboard.writeText(btn.getAttribute('data-ea-copy')).then(done, done);
    });
  });
</script>

{% schema %}
{
  "name": "Artigo Enviagora",
  "tag": "div",
  "class": "enviagora-article-section",
  "settings": []
}
{% endschema %}
