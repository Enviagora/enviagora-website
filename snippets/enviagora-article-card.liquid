{%- comment -%}
  Card de artigo do blog (listagem e "Continue lendo").
  Parâmetros:
  - article: o artigo
  - featured: true para o card em destaque (primeiro da listagem)
  - heading_tag: 'h2' (padrão) ou 'h3'
{%- endcomment -%}
{%- liquid
  assign ea_tag = heading_tag | default: 'h2'
  assign ea_words = article.content | strip_html | split: ' ' | size
  assign ea_min = ea_words | divided_by: 200 | at_least: 1
  assign ea_alt = article.image.alt | default: article.title | escape
  if featured
    assign ea_sizes = '(min-width: 990px) 60vw, 100vw'
  else
    assign ea_sizes = '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw'
  endif
-%}
<article class="ea-card{% if featured %} ea-card--featured{% endif %}">
  <a class="ea-card__link" href="{{ article.url }}">
    <div class="ea-card__media">
      {%- if article.image -%}
        {{
          article.image
          | image_url: width: 1400
          | image_tag:
            loading: 'lazy',
            widths: '360, 540, 720, 960, 1200, 1400',
            sizes: ea_sizes,
            alt: ea_alt,
            class: 'ea-card__img'
        }}
      {%- else -%}
        <div class="ea-card__placeholder">
          {%- render 'enviagora-arrow' -%}
        </div>
      {%- endif -%}
    </div>
    <div class="ea-card__body">
      <span class="ea-card__meta">
        {{- article.published_at | date: '%d/%m/%Y' }} · {{ ea_min }} min de leitura
      </span>
      <{{ ea_tag }} class="ea-card__title">{{ article.title | escape }}</{{ ea_tag }}>
      <p class="ea-card__excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 34 }}</p>
      <span class="ea-card__more">
        Ler artigo
        {%- render 'enviagora-arrow' -%}
      </span>
    </div>
  </a>
</article>
