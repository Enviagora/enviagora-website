{%- comment -%}
  Estilos do blog Enviagora (listagem + artigo). Unidades em px: o Dawn usa
  html { font-size: 62.5% }, então rem aqui valeria 10px.
{%- endcomment -%}
<style>
  .ea-blog-page { background: var(--ea-creme, #fafaf5); color: #123336; font-family: var(--font-body-family); letter-spacing: 0; }
  .ea-blog-page *, .ea-blog-page *::before, .ea-blog-page *::after { box-sizing: border-box; }
  .ea-wrap { max-width: 1184px; margin: 0 auto; padding: 0 clamp(20px, 5vw, 48px); }
  .ea-kicker-l { display: inline-flex; align-items: center; gap: 8px; font-size: 12px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: #123336; }
  .ea-kicker-l svg { width: 12px; height: 12px; }

  /* ---------- Cards ---------- */
  .ea-card { min-width: 0; }
  .ea-card__link { display: flex; flex-direction: column; height: 100%; background: #fff; border: 1px solid rgba(18,51,54,.12); border-radius: 16px; overflow: hidden; color: inherit; text-decoration: none; transition: border-color .25s, transform .25s; }
  .ea-card__link:hover { border-color: rgba(18,51,54,.35); }
  .ea-card__media { position: relative; aspect-ratio: 16 / 9; background: #dee3e0; overflow: hidden; }
  .ea-card__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform .6s cubic-bezier(.22,1,.36,1); }
  .ea-card__link:hover .ea-card__img { transform: scale(1.03); }
  .ea-card__placeholder { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; background: #123336; color: #c4ff57; }
  .ea-card__placeholder svg { width: 56px; height: 56px; }
  .ea-card__body { display: flex; flex: 1; flex-direction: column; gap: 10px; padding: 20px 22px 22px; }
  .ea-card__meta { font-size: 12px; color: #2a5b5f; }
  .ea-card__title { margin: 0; font-family: var(--font-heading-family); font-size: 19px; line-height: 1.3; font-weight: 700; letter-spacing: 0; text-transform: none; color: #123336; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .ea-card__excerpt { margin: 0; font-size: 15px; line-height: 1.6; color: #2a5b5f; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .ea-card__more { margin-top: auto; padding-top: 6px; display: inline-flex; align-items: center; gap: 8px; font-size: 12px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: #123336; }
  .ea-card__more svg { width: 11px; height: 11px; transition: transform .25s; }
  .ea-card__link:hover .ea-card__more svg { transform: translate(2px, -2px); }

  @media (min-width: 990px) {
    .ea-card--featured { grid-column: 1 / -1; }
    .ea-card--featured .ea-card__link { flex-direction: row; }
    .ea-card--featured .ea-card__media { flex: 0 0 58%; aspect-ratio: auto; min-height: 380px; }
    .ea-card--featured .ea-card__body { justify-content: center; gap: 14px; padding: 40px 44px; }
    .ea-card--featured .ea-card__title { font-family: var(--font-heading-family); font-size: 30px; line-height: 1.15; font-weight: 500; text-transform: uppercase; letter-spacing: .02em; -webkit-line-clamp: 4; }
    .ea-card--featured .ea-card__excerpt { font-size: 16px; -webkit-line-clamp: 4; }
  }

  .ea-grid { display: grid; gap: 20px; grid-template-columns: 1fr; }
  @media (min-width: 750px) { .ea-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; } }
  @media (min-width: 990px) { .ea-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
</style>
