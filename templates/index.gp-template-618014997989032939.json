ify.com/s/files/1/0709/0595/4577/files/gempages_490759501482296354-bb8375e1-e113-4997-9859-ff1cee9c36cb.png","ggtpq6LwQ9-_srcSet_mobile_src":"https://cdn.shopify.com/s/files/1/0709/0595/4577/files/gempages_490759501482296354-3f1f0640-ca1a-4943-b4b0-8876207d0f73.png","ggw5oAqC4fA_text":"\u003cp\u003eEconomize até 60% com incentivos fiscais\u003c/p\u003e","section_preload":"true"},"type":"gp-section-618014998207595499"},"gp_section_618014998207661035":{"settings":{"checksum":"03ee3264495ac9940eb30556266df0850c4357e15eb680fbf1289358bbada8a9_1_1_1_0__1","gg7qBEam62H_background_desktop_image_src":"https://cdn.shopify.com/s/files/1/0709/0595/4577/files/gempages_490759501482296354-328f43c5-3b62-4a40-b830-3d3760b0fd03.png","gg7qBEam62H_background_mobile_image_src":"https://cdn.shopify.com/s/files/1/0709/0595/4577/files/gempages_490759501482296354-328f43c5-3b62-4a40-b830-3d3760b0fd03.png","ggDbtGTRCbk_childItem_0":"\u003cp\u003e\u003cspan style=\"background-color:transparent;color:#F4F4F4;font-size:px;\"\u003eExclusivo para marcas de suplementos, cosméticos e nutracêuticos com +5.000 envios/mês\u003c/span\u003e\u003c/p\u003e","section_preload":"true"},"type":"gp-section-618014998207661035"},"gp_section_618014998207726571":{"settings":{"checksum":"7def88eff9827b8c828c506aa85a4ef2272a050af592007b6d2f0e4522386121_1_1_1_0__1","ggAbQl4KgUf_text":"\u003cp\u003eO centro de fulfillment opera de segunda a sexta-feira, das 7h30 às 17h30, garantindo que os pedidos sejam processados e enviados dentro desse período\u003c/p\u003e","ggEcqhp_pw3_text":"\u003cp\u003eA Enviagora gerencia todo o processo de devoluções e trocas, garantindo que os produtos sejam inspecionados, recondicionados (se necessário) e reintegrados ao estoque ou descartados adequadamente.\u003c/p\u003e","ggKaRQVsvT6_text":"\u003cp\u003eFulfillment é o processo completo de gerenciamento de pedidos, que inclui o recebimento, armazenamento, processamento, embalagem e envio dos produtos ao cliente final.\u003c/p\u003e","ggMBKQZeBXt_text":"\u003cp\u003e\u003cstrong\u003eFicou com dúvidas?\u003c/strong\u003e Entre em contato agora mesmo com um de nossos especialistas!\u003c/p\u003e","ggS9mV8ntiK_text":"\u003cp\u003eA Enviagora é o único fulfillment para e-commerces no Brasil que não cobra taxas escondidas em fretes. Vamos conectar a sua empresa diretamente com as transportadoras.\u003c/p\u003e","ggS_zYUP33U_childItem_0":"\u003cp\u003eO que é o serviço de fulfillment?\u003c/p\u003e","ggS_zYUP33U_childItem_1":"\u003cp\u003eQuais são os custos?\u003c/p\u003e","ggS_zYUP33U_childItem_2":"\u003cp\u003eQuais sistemas preciso ter?\u003c/p\u003e","ggS_zYUP33U_childItem_3":"\u003cp\u003eComo é o processo devoluções e trocas?\u003c/p\u003e","ggS_zYUP33U_childItem_4":"\u003cp\u003eComo a Enviagora consegue os fretes mais baratos do Brasil?\u003c/p\u003e","ggS_zYUP33U_childItem_5":"\u003cp\u003eComo acompanho o status dos meus pedidos e estoque?\u003c/p\u003e","ggS_zYUP33U_childItem_6":"\u003cp\u003eQual é o tempo de implementação?\u003c/p\u003e","ggS_zYUP33U_childItem_7":"\u003cp\u003eA Enviagora é só para e-commerce?\u003c/p\u003e","ggS_zYUP33U_childItem_8":"\u003cp\u003eO fulfillment é para empresas de diferentes tamanhos?\u003c/p\u003e","ggS_zYUP33U_childItem_9":"\u003cp\u003eQuais são os horários de operação?\u003c/p\u003e","ggU-dTXvoyo_text":"\u003cp\u003eOs custos variam conforme o volume de pedidos, o tipo de produtos, e os serviços adicionais solicitados. Entre em contato com a Enviagora para uma cotação personalizada.\u003c/p\u003e","ggWyarwXhWk_text":"\u003cp\u003eVocê pode acompanhar o status dos pedidos e o inventário em tempo real através do painel de controle online fornecido pela Enviagora, que é intuitivo e fácil de usar.\u003c/p\u003e","ggb3tCfuFvY_label":"\u003cp\u003eQuero falar com um especialista\u003c/p\u003e","ggk07HvcSNe_text":"Perguntas frequentes","gglUgFsMOz7_text":"\u003cp\u003eSim, atendemos empresas de diferentes tamanhos, mas tenha em mente que a nossa cobrança mínima é de \u0026nbsp;3.000 pedidos mensais.\u003c/p\u003e","ggrElxUQlM__text":"\u003cp\u003ePara iniciar o serviço de fulfillment na sua empresa, você vai precisar de três sistemas principais\u0026nbsp;\u003c/p\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eERP\u003c/strong\u003e\u003c/p\u003e\u003cp\u003ePara operar você deve ter uma conta de ERP configurada com o CNPJ da sua empresa, essa plataforma serve para receber os pedidos do e-commerce, gerar as notas fiscais, emitir as etiquetas de envio e controlar o estoque. Recomendamos que você contrate um ERP que disponibilize diversas opções de integrações como Tiny ERP e Bling ERP.\u0026nbsp;\u003c/p\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eE-commerce\u0026nbsp;\u003c/strong\u003e\u003c/p\u003e\u003cp\u003ePara vender online você precisa contratar uma plataforma de e-commerce, é o lugar onde você vai disponibilizar sua loja online e oferecer seus produtos. É importante contratar uma plataforma de confiança como Shopify, Nuvemshop ou Yampi.\u003c/p\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003cp\u003e\u003cstrong\u003ePlataforma de fretes\u0026nbsp;\u003c/strong\u003e\u003c/p\u003e\u003cp\u003ePara disponibilizar cotações e opções de frete em seu e-commerce você precisará uma plataforma de fretes, onde as tabelas de frete da Enviagora serão configuradas para oferecer as opções mais baratas de frete para seus clientes! Recomendamos a plataforma Frenet.\u003c/p\u003e","ggvkMrhKii1_text":"\u003cp\u003eO tempo de implementação pode variar, mas geralmente é concluído dentro de 30 dias após a finalização do contrato e abertura da filial em nosso endereço.\u003c/p\u003e","ggylaeaAArd_text":"\u003cp\u003eNão, não é só para e-commerce. Também operamos marcas B2B que entregam múltiplos volumes para um só cliente.\u003c/p\u003e"},"type":"gp-section-618014998207726571"}},"order":["gp_section_618014998207661035","gp_section_618014998207595499","gp_section_618014998207529963","gp_section_618014998207464427","gp_section_618014998207202283","gp_section_618014998207333355","gp_section_618014998207398891","gp_section_618014998207136747","gp_section_618014998207726571","gp_section_618014998207267819"]}